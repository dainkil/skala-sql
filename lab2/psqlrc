-- =====================================================================
--  lab2/psqlrc — 캡처용 psql 출력 설정
--  사용법 : PSQLRC=lab2/psqlrc psql skala_db
--  ~/.psqlrc 대신 이 파일만 읽으므로 개인 설정과 섞이지 않는다.
--
--  주의 : 백슬래시 메타명령 줄에는 -- 주석을 붙이면 안 된다.
--         psql 은 그 줄 전체를 명령 인자로 읽어서 주석 단어까지 인자로 넘긴다.
--         설명은 반드시 별도 줄에 둔다.
-- =====================================================================

-- 결과가 less 로 넘어가면 화면 캡처가 잘린다
\pset pager off

-- 표 바깥 테두리까지 그려 캡처 가독성을 높인다
\pset border 2

-- NULL 을 빈칸이 아니라 눈에 보이게 표시한다
\pset null '[NULL]'

-- 罫線 문자로 표를 그린다
\pset linestyle unicode

-- 실행 시간을 표시한다
\timing on

\set ON_ERROR_STOP on

SET search_path TO lab, public;
